global {
	wan_interface: auto
	lan_interface: podman0
	tcp_check_url: 'http://cp.cloudflare.com'
}

node {
	local: 'socks5://127.0.0.1:9909'
}

dns {
	ipversion_prefer: 4 # IPv6 在某些网络环境下是个悲剧
	upstream {
		alidns: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com'
		cloudflare: 'https://1.1.1.1/dns-query?tls_server_name=cloudflare-dns.com'
	}
	routing {
		request {
			qtype(https, svcb) -> reject # 阻止浏览器绕过
			qname(geosite:category-ads, geosite:category-ads-all) -> reject
			qname(geosite:cn, geosite:geolocation-cn, geosite:tld-cn) -> alidns
			fallback: cloudflare
		}
		response {
			upstream(cloudflare) -> accept
			ip(geoip:private) && !qname(geosite:cn, geosite:geolocation-cn, geosite:tld-cn) -> cloudflare
			fallback: accept
		}
	}
}

group {
	proxy {
		policy: min_moving_avg
	}
}

routing {
	pname(systemd-resolved, dnsmasq) && dport(53) -> direct(must)
	pname(NetworkManager) -> direct
	dport(123) -> direct # NTP 不能走代理

	pname(
		geph5-client, geph5-client-gui, gephgui-wry, mihomo, clash-rs,
		hysteria2, naiveproxy, sing-box, v2ray, xray, cloudflared,
		tailscaled, localsend_app, qbittorrent, AdGuardHome
	) -> direct(must)

	dip(geoip:private, 224.0.0.0/3, 'ff00::/8') -> direct(must)

	domain(geosite:category-ads, geosite:category-ads-all) -> block
	dport(53) -> block # 注释此项以让床底下的国家安全战士和你一起乐
	dip(geoip:cn) -> direct # 不能误杀国内软件的 QUIC……虽然真的有国产软件用 QUIC 吗？
	domain(suffix: steamserver.net, geosite:cn, geosite:geolocation-cn, geosite:tld-cn) -> direct
	l4proto(udp) && dport(443) -> block # 只干掉境外 QUIC，不影响实时 UDP
	domain(geosite:category-public-tracker) -> direct
	fallback: proxy
}
